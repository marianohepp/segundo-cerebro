# Basura del SO
Thumbs.db
Desktop.ini
.DS_Store

# Temporales
*.tmp
*.bak
~$*

# Nada de secretos en el repo (por las dudas)
*.env
.env
credentials*.json
service-account*.json
*token*.txt

# Datos sensibles de terceros — viven en H:\CEREBRO-PRIVADO-LOCAL\ (fuera de esta carpeta).
# Se deja este patrón por si alguna vez se crea una carpeta privada acá dentro por error.
_PRIVADO-LOCAL/
CEREBRO-PRIVADO-LOCAL/

# Temporales de Google Drive (reflejo)
.tmp.driveupload/
.tmp.drivedownload/

# Config de Obsidian (app de lectura): no hace falta versionarla
.obsidian/

# Archivos multimedia pesados (audio/video de Zoom): quedan en Drive, NO en git
*.m4a
*.mp4
*.mov
*.wav
*.mp3
*.m4v

# PDFs pesados (materiales oficiales con muchas imágenes): quedan en Drive, NO en git
*.pdf
